    "instructions": [
        {
            "name": "close_seller",
            "docs": [
                "Closes a seller profile and refunds rent to its authority. Needed for",
                "migration: profiles created under the old, smaller account layout",
                "cannot deserialize after upgrade and must be closed and re-initialized.",
                "Authority-signed, so only a seller can close its own profile."
            ],
            "discriminator": [
                41,
                0,
                67,
                250,
                136,
                2,
                246,
                225
            ],
            "accounts": [
                {
                    "name": "authority",
                    "writable": true,
                    "signer": true
                },
                {
                    "name": "seller_profile",
                    "docs": [
                        "The profile to close. Deliberately unchecked: old-layout accounts",
                        "cannot deserialize as SellerProfile, but the seeds constraint still",
                        "cryptographically binds this to the canonical PDA for the signing",
                        "authority — no other account can be passed.",
                        "is only possible because the program owns the account."
                    ],
                    "writable": true,
                    "pda": {
                        "seeds": [
                            {
                                "kind": "const",
                                "value": [
                                    115,
                                    101,
                                    108,
                                    108,
                                    101,
                                    114
                                ]
                            },
                            {
                                "kind": "account",
                                "path": "authority"
                            }
                        ]
                    }
                }
            ],
            "args": []
        },
