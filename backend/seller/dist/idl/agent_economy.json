        {
            "name": "record_payment",
            "docs": [
                "Admin-gated legacy instruction, kept only for seeding demo history.",
                "",
                "SECURITY NOTE: in earlier versions this was publicly callable",
                "(buyer-signed) and verified no payment — meaning reputation was",
                "writable by anyone with no money moving (the audit's #1 finding).",
                "Live traffic now goes through pay_and_record, where the transfer and",
                "the record are one atomic instruction. This path remains solely so the",
                "protocol admin can seed synthetic demo agents, and any history written",
                "through it is by definition synthetic — the frontend labels it as such."
            ],
            "discriminator": [
